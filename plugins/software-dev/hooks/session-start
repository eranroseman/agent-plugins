#!/usr/bin/env bash
# SessionStart hook for the software-dev plugin, Claude Code only.
#
# Prints hooks/using-superpowers.md and hooks/working-rules.md (next to this
# script), joined by one blank line. Claude Code adds a SessionStart hook's
# stdout to the context as it stands, so no JSON envelope is needed.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cat "${SCRIPT_DIR}/using-superpowers.md"
printf '\n'
cat "${SCRIPT_DIR}/working-rules.md"

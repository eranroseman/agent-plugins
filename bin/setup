#!/usr/bin/env bash
# Apply and verify the machine state this repository declares.
#
#   bin/setup           check, apply, re-check; non-zero if anything remains
#   bin/setup --check   check and report only (this is what bin/doctor runs)
#
# The desired state is read from the checkout this script lives in, never from
# the machine:
#   .claude-plugin/marketplace.json   every subset (git-subdir) entry: url,
#                                     sha, version, and its skill names
#   skills.json                       the skills.sh set: repo, ref, names
#
# The machine is reached through HOME and CODEX_HOME and nothing else, so a
# scratch home is a complete test fixture.
#
# `set -e` is deliberately absent: a failing check must be reported and
# counted, not fatal. Only a missing prerequisite or a missing desired-state
# file exits early, with status 2.
set -uo pipefail

# bash 4.4 or later, refused before anything else runs and with builtins
# only: below 4.4 an empty array's "${a[@]}" is unbound under set -u and the
# engine dies mid-check with no verdict (#61 M3). Every distribution that
# ships an older bash is end of life, so the version goes, not the idiom.
if [ "${BASH_VERSINFO[0]}" -lt 4 ] || { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -lt 4 ]; }; then
  printf 'ERROR: bin/setup needs bash 4.4 or later (found %s.%s)\n' "${BASH_VERSINFO[0]}" "${BASH_VERSINFO[1]}" >&2
  exit 2
fi

# Builtins only until require_tools has spoken: under an empty PATH the
# external dirname is `command not found`, and that line, carrying the
# script's own path, once satisfied a test's grep for `claude` before the
# refusal was printed (#16). A $0 with no slash was found through PATH or run
# as `bash setup` from its own directory, so its directory is `.`.
script_dir="${0%/*}"
[ "$script_dir" != "$0" ] || script_dir=.
REPO_ROOT="$(cd "$script_dir/.." && pwd)"
MARKETPLACE="$REPO_ROOT/.claude-plugin/marketplace.json"
SKILLS_JSON="$REPO_ROOT/skills.json"

# Each later task adds the variables its own checks need, beside them, rather
# than here: a variable declared before anything reads it is a shellcheck
# SC2034 warning, and shellcheck must exit 0 from Task 4 onward.
# One pinned clone per subset (git-subdir) marketplace entry, named after it:
#   $UPSTREAM_ROOT/superpowers, $UPSTREAM_ROOT/writing-clearly-and-concisely
UPSTREAM_ROOT="$HOME/.local/share/software-dev/upstream"
SKILL_ROOT="$HOME/.agents/skills"
KNOWN_MARKETPLACES="$HOME/.claude/plugins/known_marketplaces.json"
INSTALLED_PLUGINS="$HOME/.claude/plugins/installed_plugins.json"
LOCKFILE="$HOME/.agents/.skill-lock.json"
CODEX_SKILLS="${CODEX_HOME:-$HOME/.codex}/skills"

# The only override. CI points this at the checkout under test, because
# `claude plugin marketplace add eranroseman/agent-plugins` would clone origin
# main and test the wrong desired state.
MARKETPLACE_SOURCE="${SD_MARKETPLACE_SOURCE:-eranroseman/agent-plugins}"

# Codex takes a git URL rather than an owner/repo pair.
CODEX_MARKETPLACE_SOURCE="https://github.com/eranroseman/agent-plugins.git"
CODEX_LIST=""

MODE=apply
FAILURES=0

# Every ok, bad, skip and note bumps this; did does not, because a DID: line
# never stands alone on any path. Each check is bracketed by a snapshot of
# it and a reported() call.
REPORTED=0

# Checks that could not run, and the tools they wanted. Only `needs` fills
# these, never the claude and codex gates: those skip a half that is genuinely
# inapplicable, and a machine with neither agent CLI can still be clean. A
# missing reader of the desired state is a different kind of absence -- nothing
# was checked at all -- and it must not read as a healthy machine.
UNANSWERED=0
UNCHECKED=""

# Reporting. Each later task adds the one helper it is the first to call —
# `did` in Task 5, `skip` in Task 6, `note` in Task 9 — for the same reason the
# path variables are staged: shellcheck reports a function nothing calls
# (SC2317) and the lint assertion requires a clean exit.
ok() {
  printf 'OK:   %s\n' "$*"
  REPORTED=$((REPORTED + 1))
}
bad() {
  printf 'FAIL: %s\n' "$*"
  FAILURES=$((FAILURES + 1))
  REPORTED=$((REPORTED + 1))
}
die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 2
}
did() { printf 'DID:  %s\n' "$*"; }
skip() {
  printf 'SKIP: %s\n' "$*"
  REPORTED=$((REPORTED + 1))
}
note() {
  printf 'NOTE: %s\n' "$*"
  REPORTED=$((REPORTED + 1))
}

applying() { [ "$MODE" = apply ]; }
have() { command -v "$1" >/dev/null 2>&1; }

# A tool a check cannot run without. require_tools has already refused in apply
# mode, so this only ever speaks for the doctor, where nothing may be fatal and
# no check may fall silent: without jq the sha reads empty and the doctor calls
# the desired state malformed, then iterates an empty skill list and an empty
# skill set without a word. Each caller reports its own half, the way the
# claude and codex gates already do.
needs() {
  if have "$1"; then return 0; fi
  skip "$1 is not on PATH: $2"
  UNANSWERED=$((UNANSWERED + 1))
  case " $UNCHECKED " in
    *" $1 "*) ;;
    *) UNCHECKED="$UNCHECKED $1" ;;
  esac
  return 1
}

# Every check reports, or the run fails (spec §6.1). A check that prints
# nothing has verified nothing: a jq program that emitted rows with empty
# names, a loop whose every iteration hit `continue`. Each call site
# snapshots REPORTED, runs the check directly, and passes the snapshot and
# the name here: no capture and no subshell, because the checks run in
# main's own shell and a $(...) around them would lose every increment bad
# and needs make to FAILURES, UNANSWERED and UNCHECKED; and no wrapper that
# invokes the check through "$@", because shellcheck then reports every
# check and every helper they call as unreachable (SC2317). A silent check
# is a defect in the engine, so it is bad, counted in "N check(s) failed",
# and not the `for want of:` verdict, which is for a tool the machine lacks.
# Nested callers bracket their callees at their own sites: report_only
# prints NOTE lines before report_duplicates, and report_duplicates
# before report_pool, so a bracket around the outer call alone would see a
# count and never notice the inner one saying nothing.
reported() {
  [ "$REPORTED" -gt "$1" ] \
    || bad "check $2 reported nothing; this machine is unchecked, not verified"
}

usage() {
  cat <<'EOF'
usage: bin/setup [--check]
       bin/doctor

bin/setup applies the machine state this repository declares, then re-checks it.
bin/doctor is the same engine in check mode: it reports and changes nothing.

Both read the desired state from the checkout the script lives in, and reach
the machine only through HOME and CODEX_HOME.

Bootstrap on a new machine:

claude plugin marketplace add eranroseman/agent-plugins
bash ~/.claude/plugins/marketplaces/eranroseman/bin/setup

Update an installed machine:

claude plugin marketplace update eranroseman
codex plugin marketplace upgrade eranroseman
bash ~/.claude/plugins/marketplaces/eranroseman/bin/setup

bin/setup needs git, jq, node, npx and claude, and refuses without them. codex
is optional: its half is reported as skipped when the binary is absent.
bin/doctor requires nothing and reports whatever it cannot check.

Neither ever writes a configuration file by hand. Every settings.json and
config.toml write is the CLI's own, made by a command run here. The operator
decisions are only reported, never made here: the plugin auto-update toggle in
/plugin, and the variables the plugin README documents.
EOF
}

require_tools() {
  local t missing=""
  applying || return 0
  for t in git jq node npx claude; do
    have "$t" || missing="$missing $t"
  done
  [ -z "$missing" ] || die "bin/setup needs these on PATH:$missing (bin/doctor needs none)"
}

# Every subset entry: a git-subdir source pinned by sha. One line each,
# tab-separated: name, url, ref, sha, path, version.
subset_entries() {
  jq -r '.plugins[] | select(.source.source? == "git-subdir")
         | [.name, .source.url, .source.ref, .source.sha, .source.path, .version] | @tsv' "$MARKETPLACE"
}

clone_dir() { printf '%s/%s' "$UPSTREAM_ROOT" "$1"; }

# A timestamped sibling, so nothing a user put here is ever destroyed.
aside_path() { printf '%s.aside.%s' "$1" "$(date +%Y%m%d%H%M%S)"; }

# Split a tab-separated line into the six fields of F by parameter expansion,
# never by feeding `read` a tab IFS: a tab is IFS whitespace, so `read`
# collapses a run of them and drops one at either end, and a row with an
# empty leading or middle field shifts every later value left by one, which
# misnames the field in the report and, when the shifted-in value looks
# non-empty, hides a genuinely empty field from the guard that follows
# (0aa11d2, in ensure_links). Six tabs are appended so a short row leaves its
# missing fields empty. F is the caller's local; bash scopes it dynamically.
split_tsv() {
  local rest="$1"$'\t\t\t\t\t\t'
  F=()
  for _ in 1 2 3 4 5 6; do
    F+=("${rest%%$'\t'*}")
    rest="${rest#*$'\t'}"
  done
}

ensure_clones() {
  local name url sha dir have n=0 line F entries
  needs jq "the subset entries cannot be read, so no pinned clone is checked" || return
  # Read whole, then looped: a non-zero jq exit means the program aborted
  # partway (a non-scalar version, say), and the rows before the abort are a
  # partial list that checks nothing. The idiom ensure_links uses (#61 M13).
  entries="$(subset_entries)" || {
    bad "the subset entries could not be read whole from $MARKETPLACE; a partial list checks nothing"
    return
  }
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    n=$((n + 1))
    split_tsv "$line"
    name="${F[0]}" url="${F[1]}" sha="${F[3]}"
    if [ -z "$name" ] || [ -z "$url" ]; then
      bad "a subset entry is malformed: name='$name' url='$url'"
      continue
    fi
    dir="$(clone_dir "$name")"
    if [ "${#sha}" -ne 40 ]; then
      bad "the $name entry carries no 40-character sha"
      continue
    fi
    if [ ! -d "$dir/.git" ]; then
      if ! applying; then
        bad "the pinned clone for $name is missing: $dir"
        continue
      fi
      mkdir -p "$(dirname "$dir")" || {
        bad "could not create $(dirname "$dir")"
        continue
      }
      # Never chained with &&: a failed clone would short-circuit the checkout
      # and leave the directory at whatever it happened to be.
      if git clone -q "$url" "$dir"; then
        did "cloned $url into $dir"
      else
        bad "could not clone $url into $dir"
        continue
      fi
    fi

    have="$(git -C "$dir" rev-parse HEAD 2>/dev/null)"
    if [ "$have" = "$sha" ]; then
      ok "pinned clone $name is at $sha"
      continue
    fi
    if ! applying; then
      bad "pinned clone $name is at ${have:-an unknown revision}, declared $sha"
      continue
    fi
    git -C "$dir" fetch -q origin || {
      bad "could not fetch in $dir"
      continue
    }
    if git -C "$dir" checkout -q "$sha"; then
      did "checked out $sha in $dir"
    else
      bad "could not check out $sha in $dir"
      continue
    fi
    have="$(git -C "$dir" rev-parse HEAD 2>/dev/null)"
    if [ "$have" = "$sha" ]; then
      ok "pinned clone $name is at $sha"
    else
      bad "pinned clone $name is at ${have:-an unknown revision}, declared $sha"
    fi
  done <<<"$entries"
  [ "$n" -gt 0 ] || bad "no subset (git-subdir) entry could be read from $MARKETPLACE"
}

ensure_links() {
  local entry epath skill name target link actual aside lines line F
  if applying; then
    mkdir -p "$SKILL_ROOT" || {
      bad "could not create $SKILL_ROOT"
      return
    }
  elif [ ! -d "$SKILL_ROOT" ]; then
    bad "the skill root is missing: $SKILL_ROOT"
    return
  fi
  # After the skill root, which needs no jq: without the subset entries' list
  # the loop below iterates nothing and reports nothing at all.
  needs jq "the subset entries' skill list cannot be read, so no link is checked" || return

  # A non-zero jq exit means the program aborted partway through -- most often
  # a subset entry with no `skills` array, or a non-string element in one --
  # and whatever it printed before aborting is a partial list, not the full
  # one. Row count cannot stand in for this: if the *first* entry is the bad
  # one the loop below simply never runs, but a later entry being bad still
  # leaves every prior entry's rows behind, so a `> 0` guard on the count
  # would pass while that entry's links go entirely unchecked. The exit status
  # is the only thing that tells the two cases apart.
  lines="$(jq -r '.plugins[] | select(.source.source? == "git-subdir") as $p
                  | $p.skills[] | [$p.name, $p.source.path, (. | sub("^\\./"; ""))] | @tsv' "$MARKETPLACE")" \
    || {
      bad "the subset entries' skill list could not be read from $MARKETPLACE"
      return
    }
  [ -n "$lines" ] || {
    bad "no subset entry declares a skill in $MARKETPLACE"
    return
  }

  # Every skill of every subset entry: the link target is the skill directory
  # inside that entry's pinned clone, under the entry's source.path, and the
  # link is named after the directory's basename.
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    split_tsv "$line"
    entry="${F[0]}" epath="${F[1]}" skill="${F[2]}"
    if [ -z "$entry" ] || [ -z "$epath" ] || [ -z "$skill" ]; then
      bad "a subset entry's skill line is malformed: entry='$entry' path='$epath' skill='$skill'"
      continue
    fi
    name="$(basename "$skill")"
    target="$(clone_dir "$entry")/$epath/$skill"
    link="$SKILL_ROOT/$name"

    # The target first: moving a squatter aside before knowing the link can be
    # created leaves the user with neither their file nor a link. In check mode
    # this is the root cause of every other verdict below it.
    if [ ! -e "$target" ]; then
      bad "link target missing: $target"
      continue
    fi

    if [ -L "$link" ]; then
      # Dangling first, and by `[ -e ]` on the link rather than by an empty
      # readlink: `readlink -f` canonicalizes a path whose last component does
      # not exist and returns it, so a dangling link reports a target here, not
      # the empty string. `[ -e ]` follows the link and is false exactly when
      # the target is missing -- which is also why the README's guard passed on
      # a dangling link and let `ln -s` fail with "File exists".
      if [ ! -e "$link" ]; then
        if ! applying; then
          bad "dangling link: $link"
          continue
        fi
        # Moved aside like every other squatter, never deleted: the target may
        # be a volume that is merely unmounted. Plain readlink rather than -f,
        # because what the link stores is the only record of where it pointed
        # and -f canonicalizes a missing target into something else.
        actual="$(readlink "$link" 2>/dev/null)"
        aside="$(aside_path "$link")"
        mv "$link" "$aside" || {
          bad "could not move the dangling $link aside"
          continue
        }
        did "moved $link aside to $aside (it pointed at $actual)"
      else
        actual="$(readlink -f "$link" 2>/dev/null)"
        if [ "$actual" = "$target" ]; then
          ok "link $name"
          continue
        fi
        if ! applying; then
          bad "link $name points at $actual, not $target"
          continue
        fi
        aside="$(aside_path "$link")"
        mv "$link" "$aside" || {
          bad "could not move $link aside"
          continue
        }
        did "moved $link aside to $aside (it pointed at $actual)"
      fi
    elif [ -e "$link" ]; then
      # A directory or a regular file where a link belongs. Never deleted.
      if ! applying; then
        bad "$name exists and is not a symlink: $link"
        continue
      fi
      aside="$(aside_path "$link")"
      mv "$link" "$aside" || {
        bad "could not move $link aside"
        continue
      }
      did "moved $link aside to $aside (not a symlink)"
    fi

    if ! applying; then
      bad "missing link: $link"
      continue
    fi
    if ln -s "$target" "$link"; then
      did "linked $name"
      ok "link $name"
    else
      bad "could not create $link"
    fi
  done <<<"$lines"
}

plugin_version() {
  jq -r '.version' "$REPO_ROOT/plugins/software-dev/.claude-plugin/plugin.json"
}

installed_version() {
  jq -r --arg k "$1@eranroseman" \
    '.plugins[$k][0].version // empty' "$INSTALLED_PLUGINS" 2>/dev/null
}

ensure_claude() {
  local want have installed_sd name line F entries
  if ! have claude; then
    skip "claude is not on PATH: the Claude half is unchecked"
    return
  fi
  needs jq "the declared plugin versions cannot be read, so the Claude half is unchecked" || return
  want="$(plugin_version)"
  [ -n "$want" ] || {
    bad "could not read the declared plugin version"
    return
  }

  installed_sd="$(installed_version software-dev)"
  if [ "$installed_sd" != "$want" ] && applying; then
    if [ -z "$installed_sd" ]; then
      # Adding is a clean no-op on re-run, but only add when the marketplace is
      # unknown: an existing entry may point at a different source than ours.
      if ! jq -e '.eranroseman' "$KNOWN_MARKETPLACES" >/dev/null 2>&1; then
        if claude plugin marketplace add "$MARKETPLACE_SOURCE" >/dev/null 2>&1; then
          did "added the eranroseman marketplace from $MARKETPLACE_SOURCE"
        else
          bad "claude plugin marketplace add $MARKETPLACE_SOURCE failed"
          return
        fi
      fi
      # --scope user, never --scope project: project scope writes a checked-in
      # .claude/settings.json carrying enabledPlugins and extraKnownMarketplaces.
      # No -y: claude 2.1.220, the version CI pins, rejects it outright with
      # "error: unknown option". Where the flag does exist it only waives the
      # confirmation for a plugin installed by running a marketplace-declared
      # command, or one fetched through a headersHelper, and this is neither.
      if claude plugin install software-dev@eranroseman --scope user >/dev/null 2>&1; then
        did "installed software-dev@eranroseman (with sensemaking and superpowers)"
      else
        bad "claude plugin install software-dev@eranroseman failed"
      fi
    else
      # install is a no-op on an already-installed plugin: it prints "already
      # installed", exits 0, and leaves the old version on disk (measured
      # 2026-09-05 on claude 2.1.261, both directory- and github-source
      # marketplaces). update is the only verb that moves it, and it exits 0
      # when it decides nothing needs moving, so the re-read below is what
      # reports success.
      claude plugin update software-dev@eranroseman >/dev/null 2>&1 \
        || bad "claude plugin update software-dev@eranroseman failed"
      if [ "$(installed_version software-dev)" = "$want" ]; then
        did "updated software-dev@eranroseman from $installed_sd to $want"
      fi
    fi
  fi

  installed_sd="$(installed_version software-dev)"
  if [ "$installed_sd" = "$want" ]; then
    ok "software-dev@eranroseman $want installed"
  else
    bad "software-dev@eranroseman is ${installed_sd:-not installed}, declared $want"
  fi

  # sensemaking installs itself as a dependency of the first install, but a
  # parent's update does not carry it (sub-project 2's plan, B2), so a copy
  # behind its manifest moves under its own update. `[ -n "$have" ]` first:
  # update fails against a plugin that is not installed, and a missing
  # dependency is the parent install's business. A version the manifest
  # does not carry is a FAIL, never an OK against an empty string (#17).
  want="$(jq -r '.version // empty' "$REPO_ROOT/plugins/sensemaking/.claude-plugin/plugin.json" 2>/dev/null)"
  if [ -n "$want" ]; then
    have="$(installed_version sensemaking)"
    if [ -n "$have" ] && [ "$have" != "$want" ] && applying; then
      claude plugin update sensemaking@eranroseman >/dev/null 2>&1 \
        || bad "claude plugin update sensemaking@eranroseman failed"
      have="$(installed_version sensemaking)"
      [ "$have" = "$want" ] && did "updated sensemaking@eranroseman to $want"
    fi
    if [ "$have" = "$want" ]; then
      ok "sensemaking@eranroseman $want installed"
    else
      bad "sensemaking@eranroseman is ${have:-not installed}, declared $want"
    fi
  else
    bad "sensemaking version unreadable from plugins/sensemaking/.claude-plugin/plugin.json"
  fi
  # Every subset entry, by its declared version. superpowers arrives as a
  # dependency of the first install; an entry declared after a machine was set
  # up does not -- measured 2026-09-06 on claude 2.1.263, `claude plugin update
  # software-dev` moved the parent from 0.6.0 to 0.7.0 and left its new
  # dependency uninstalled -- so a missing entry is installed by name. An
  # installed one at the wrong version only moves under `update`.
  entries="$(subset_entries)" || {
    bad "the subset entries could not be read whole from $MARKETPLACE; a partial list checks nothing"
    return
  }
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    split_tsv "$line"
    name="${F[0]}" want="${F[5]}"
    if [ -z "$name" ] || [ -z "$want" ]; then
      bad "a subset entry is malformed: name='$name' version='$want'"
      continue
    fi
    have="$(installed_version "$name")"
    if [ "$have" != "$want" ] && applying; then
      if [ -z "$have" ]; then
        if claude plugin install "$name@eranroseman" --scope user >/dev/null 2>&1; then
          did "installed $name@eranroseman"
        else
          bad "claude plugin install $name@eranroseman failed"
        fi
      else
        claude plugin update "$name@eranroseman" >/dev/null 2>&1 \
          || bad "claude plugin update $name@eranroseman failed"
      fi
      have="$(installed_version "$name")"
      [ "$have" = "$want" ] && [ -n "$have" ] && did "$name@eranroseman is now $want"
    fi
    if [ "$have" = "$want" ]; then
      ok "$name@eranroseman $want installed"
    else
      bad "$name@eranroseman is ${have:-not installed}, declared $want"
    fi
  done <<<"$entries"
}

codex_plugin_version() {
  # $1 plugin name; empty when not installed. `codex plugin list --json`
  # reports the *installed* version, read from $CODEX_HOME/plugins/cache,
  # never config.toml (§7.4). `codex plugin add` is Codex's only upgrade
  # verb, so presence alone is not convergence (§9 step 3).
  printf '%s' "$CODEX_LIST" \
    | jq -r --arg k "$1@eranroseman" '.installed[] | select(.pluginId == $k) | .version'
}

ensure_codex() {
  local p want got
  if ! have codex; then
    skip "codex is not on PATH: the Codex half is unchecked and unapplied"
    return
  fi
  needs jq "the declared plugin versions cannot be read, so the Codex half is unchecked" || return
  CODEX_LIST="$(codex plugin list --json 2>/dev/null)" || {
    CODEX_LIST=""
    bad "codex plugin list failed"
    return
  }

  for p in software-dev sensemaking; do
    want="$(jq -r '.version' "$REPO_ROOT/plugins/$p/.codex-plugin/plugin.json")"
    if [ -z "$want" ] || [ "$want" = null ]; then
      bad "could not read the declared version of $p"
      continue
    fi
    got="$(codex_plugin_version "$p")"
    if [ "$got" != "$want" ] && applying; then
      if codex plugin marketplace list 2>/dev/null | grep -q '^eranroseman'; then
        # Never re-run `marketplace add`: it prints "already added" and silently
        # deletes last_revision. upgrade is a true no-op when nothing moved, and
        # covers §9 step 1 when the human skipped it.
        codex plugin marketplace upgrade eranroseman >/dev/null 2>&1 \
          || bad "codex plugin marketplace upgrade failed"
      elif codex plugin marketplace add "$CODEX_MARKETPLACE_SOURCE" >/dev/null 2>&1; then
        did "added the eranroseman marketplace to Codex"
      else
        bad "codex plugin marketplace add failed"
        continue
      fi
      # Codex has no dependency concept, so both plugins are named explicitly,
      # and no update verb, so add is also the upgrade.
      if ! codex plugin add "$p@eranroseman" >/dev/null 2>&1; then
        bad "codex plugin add $p@eranroseman failed"
        continue
      fi
      # The DID line reports a re-read of the installed version, never the
      # command's exit status: add exits 0 having left the old version in
      # place, and announcing $want there printed a version that the FAIL line
      # immediately below then contradicted.
      CODEX_LIST="$(codex plugin list --json 2>/dev/null)" || CODEX_LIST=""
      got="$(codex_plugin_version "$p")"
      if [ "$got" = "$want" ]; then
        did "installed codex plugin $p $got"
      fi
    fi
    if [ "$got" = "$want" ]; then
      ok "codex plugin $p $want installed"
    else
      bad "codex plugin $p is ${got:-not installed}, declared $want"
    fi
  done
}

locked_ref() {
  jq -r --arg n "$1" '.skills[$n].ref // empty' "$LOCKFILE" 2>/dev/null
}

ensure_skills_sh() {
  local repo ref name have lines line F
  needs jq "the declared skill set cannot be read, so no skills.sh install is checked" || return

  # Same reasoning as ensure_links: a non-zero jq exit means a source with no
  # `skills` array, or a non-string element, aborted the program partway, and
  # a row count cannot distinguish that from a short but complete list.
  lines="$(jq -r '.sources[] as $s | $s.skills[] | [$s.repo, $s.ref, .] | @tsv' "$SKILLS_JSON")" \
    || {
      bad "the declared skill set could not be read from $SKILLS_JSON"
      return
    }
  [ -n "$lines" ] || {
    bad "no skill is declared in $SKILLS_JSON"
    return
  }

  while IFS= read -r line; do
    [ -n "$line" ] || continue
    split_tsv "$line"
    repo="${F[0]}" ref="${F[1]}" name="${F[2]}"
    if [ -z "$repo" ] || [ -z "$ref" ] || [ -z "$name" ]; then
      bad "a declared skill line is malformed: repo='$repo' ref='$ref' name='$name'"
      continue
    fi
    have="$(locked_ref "$name")"
    if [ "$have" = "$ref" ]; then
      ok "skills.sh $name at $ref"
      continue
    fi
    if ! applying; then
      if [ -z "$have" ]; then
        bad "lockfile entry for $name records no ref, declared $ref"
      else
        bad "lockfile records $have for $name, declared $ref"
      fi
      continue
    fi
    # The fragment form is what writes ref into the lockfile. -g keeps the
    # install in the shared root; without it a project tree and a second
    # lockfile appear beside it. </dev/null is load-bearing: npx inherits this
    # loop's stdin, which is the here-string below, and drains it, so without
    # the redirect the loop ends after its first iteration and exactly one of
    # the declared skills is ever installed.
    if npx --yes skills add "$repo#$ref" --skill "$name" -g -y </dev/null >/dev/null 2>&1; then
      did "installed $name from $repo#$ref"
    else
      bad "npx skills add $repo#$ref --skill $name failed"
      continue
    fi
    have="$(locked_ref "$name")"
    if [ "$have" = "$ref" ]; then
      ok "skills.sh $name at $ref"
    else
      bad "after installing $name the lockfile records '${have:-no ref}', declared $ref"
    fi
  done <<<"$lines"
}

ensure_fresh_clone() {
  local loc source_kind head tip
  needs jq "the marketplace registration cannot be read, so the staleness check is unanswered" || return

  # Is this script's own clone behind upstream main? A stale script applies
  # stale pins. Resolved with ls-remote, never HEAD against origin/main: on
  # 2026-09-05 all three read the same sha on a clone 22 commits behind.
  source_kind="$(jq -r '.eranroseman.source.source // empty' "$KNOWN_MARKETPLACES" 2>/dev/null)"
  loc="$(jq -r '.eranroseman.installLocation // empty' "$KNOWN_MARKETPLACES" 2>/dev/null)"
  if [ -z "$source_kind" ]; then
    skip "the eranroseman marketplace is not registered; the staleness check needs it"
  elif [ "$source_kind" != "github" ]; then
    skip "the marketplace source is a directory, so there is no clone to compare"
  elif [ ! -d "$loc/.git" ]; then
    skip "no git clone at $loc; the staleness check needs one"
  else
    head="$(git -C "$loc" rev-parse HEAD 2>/dev/null)"
    tip="$(git -C "$loc" ls-remote origin refs/heads/main 2>/dev/null | cut -f1)"
    if [ -z "$tip" ]; then
      skip "could not reach origin to resolve main; the staleness check is unanswered"
    elif [ "$head" = "$tip" ]; then
      ok "the marketplace clone is at origin/main"
    else
      bad "the marketplace clone is at $head, origin main is at $tip: run 'claude plugin marketplace update eranroseman' and re-run this script from the refreshed clone"
    fi
  fi
}

# Is the watch alive? An empty upstream-drift list means "no drift" or
# "nothing checked", and only the run history tells them apart (spec §12,
# #24). One request to the public runs API; curl is optional the way the
# Codex half is, so its absence is a plain skip and never a need, and so is
# a request that fails or outlasts 30 seconds, a response that is not 200,
# and a body that is not one JSON object with a workflow_runs array. A
# bearer token travels when GITHUB_TOKEN is set, which CI does, because
# unauthenticated requests from a shared runner address are rate-limited;
# it travels in a header file, never in curl's arguments. 48 hours, because
# scheduled runs land 4.5 to 6.5 hours after the 06:17 UTC slot and one
# missed slot is weak evidence. FAIL rather than NOTE: a machine converging
# to pins nobody is watching is a fact about that machine.
ensure_watch_fresh() {
  local url='https://api.github.com/repos/eranroseman/agent-plugins/actions/workflows/upstream-watch.yml/runs?event=schedule&status=completed&per_page=1'
  local page='https://github.com/eranroseman/agent-plugins/actions/workflows/upstream-watch.yml'
  local out code body created conclusion now ts age
  local -a req=(-sS --max-time 30 -H 'Accept: application/vnd.github+json' -w '\n%{http_code}' "$url")
  if ! have curl; then
    skip "curl is not on PATH, so the watch's run history is unread"
    return
  fi
  needs jq "the watch's run history cannot be parsed" || return
  # The token goes to curl in a header file, never in its arguments, which
  # any user's ps can read. The file is a process substitution written in
  # the curl command itself: one assigned into an array closes before curl
  # runs, curl exits 26 on the unreadable file, and the check would read as
  # an unreachable API.
  if [ -n "${GITHUB_TOKEN:-}" ]; then
    out="$(curl -H @<(printf 'Authorization: Bearer %s' "$GITHUB_TOKEN") "${req[@]}" 2>/dev/null)"
  else
    out="$(curl "${req[@]}" 2>/dev/null)"
  fi || {
    skip "could not reach the runs API; the watch's freshness is unanswered"
    return
  }
  code="${out##*$'\n'}"
  body="${out%$'\n'*}"
  if [ "$code" != 200 ]; then
    skip "the runs API answered $code, not 200; the watch's freshness is unanswered"
    return
  fi
  # Exactly one object whose workflow_runs is an array, or the body is unread:
  # an empty body, a {} or a null list would otherwise read as an empty run
  # list, a FAIL. With -s an empty body is [], which fails the test too.
  if ! printf '%s' "$body" | jq -es 'length == 1 and (.[0] | type) == "object" and (.[0].workflow_runs | type) == "array"' >/dev/null 2>&1 \
    || ! created="$(printf '%s' "$body" | jq -r '.workflow_runs[0].created_at // empty' 2>/dev/null)"; then
    skip "the runs API's body did not parse; the watch's freshness is unanswered"
    return
  fi
  if [ -z "$created" ]; then
    bad "no completed scheduled run of the watch is on record; see $page"
    return
  fi
  conclusion="$(printf '%s' "$body" | jq -r '.workflow_runs[0].conclusion // "none"')"
  now="$(date -u +%s)"
  ts="$(date -u -d "$created" +%s 2>/dev/null)" || {
    skip "the runs API's created_at did not parse: $created"
    return
  }
  age=$(((now - ts) / 3600))
  if [ "$age" -ge 48 ]; then
    bad "the watch's last scheduled run was $age hours ago, 48 or more; see $page"
  elif [ "$conclusion" != success ]; then
    bad "the watch's last scheduled run concluded $conclusion, not success; see $page"
  else
    ok "the watch ran on schedule $age hour(s) ago and succeeded"
  fi
}

report_only() {
  local v src set_names="" link actual before undeclared line F
  needs jq "the settings this script only reports cannot be read" || return

  # The telemetry variable. Setup writes it nowhere: the exposure is one
  # browser request per Visual Companion page load, and the write would be the
  # riskiest thing in this script. The plugin README documents what it prevents.
  for v in SUPERPOWERS_DISABLE_TELEMETRY DISABLE_TELEMETRY CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC; do
    if [ -n "${!v:-}" ]; then
      set_names="$set_names $v"
    elif jq -e --arg k "$v" '.env[$k] // empty' "$HOME/.claude/settings.json" >/dev/null 2>&1; then
      set_names="$set_names $v(settings.json)"
    fi
  done
  if [ -n "$set_names" ]; then
    note "telemetry is disabled by:$set_names"
  else
    note "no telemetry-disabling variable is set; see the plugin README (this script never sets one)"
  fi

  # Auto-update. A consent decision, made once in /plugin under Marketplaces.
  if jq -e '.extraKnownMarketplaces.eranroseman.autoUpdate == true' \
    "$HOME/.claude/settings.json" >/dev/null 2>&1; then
    note "marketplace auto-update is on for eranroseman"
  else
    note "marketplace auto-update is off for eranroseman; turn it on in /plugin if you want releases without an update command"
  fi

  # The archify update check: its check-update.mjs tests
  # ARCHIFY_UPDATE_CHECK_DISABLED for exactly the value 1, read from the
  # environment and from settings.json's env map. This script never sets it;
  # the plugin README says how to (#50).
  v="${ARCHIFY_UPDATE_CHECK_DISABLED:-}"
  src="the environment"
  if [ -z "$v" ]; then
    v="$(jq -r '.env.ARCHIFY_UPDATE_CHECK_DISABLED // empty' "$HOME/.claude/settings.json" 2>/dev/null)"
    src="the env map in ~/.claude/settings.json"
  fi
  if [ "$v" = 1 ]; then
    note "archify's update check is off: ARCHIFY_UPDATE_CHECK_DISABLED=1 in $src"
  elif [ -z "$v" ]; then
    note "archify's update check is on: ARCHIFY_UPDATE_CHECK_DISABLED is unset in the environment and in ~/.claude/settings.json; see the plugin README (this script never sets it)"
  else
    note "archify's update check is still on: ARCHIFY_UPDATE_CHECK_DISABLED=$v in $src, and check-update.mjs tests for exactly 1"
  fi

  # Every skills.sh install the desired state does not declare (#54): one
  # NOTE each, naming the lockfile's source and ref, worded against the
  # desired state so it stays true once #52 moves names to a subset entry.
  # The vendored scaffolder's unadapted twin keeps its remedy. Reported,
  # never removed; a lockfile jq cannot parse is a FAIL, never the all-clear.
  if [ ! -f "$LOCKFILE" ]; then
    skip "no skills.sh lockfile at $LOCKFILE; nothing to compare the desired state against"
  elif ! undeclared="$(jq -r --slurpfile d "$SKILLS_JSON" \
    '[$d[0].sources[].skills[]] as $want
     | .skills | to_entries[]
     | select(.key as $k | $want | index($k) | not)
     | [.key, (.value.source // "unknown source"), (.value.ref // "no ref")] | @tsv' \
    "$LOCKFILE" 2>/dev/null)"; then
    bad "the lockfile at $LOCKFILE could not be parsed, so undeclared installs are unknown"
  elif [ -z "$undeclared" ]; then
    note "every skills.sh install in the lockfile is in the skills.sh desired state"
  else
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      split_tsv "$line"
      if [ "${F[0]}" = setup-matt-pocock-skills ]; then
        note "setup-matt-pocock-skills is installed through skills.sh, but this plugin vendors an adapted copy as setup-repository; remove the unadapted one with 'npx skills remove setup-matt-pocock-skills -g'"
      else
        note "skills.sh install ${F[0]} (${F[1]} at ${F[2]}) is not in the skills.sh desired state"
      fi
    done <<<"$undeclared"
  fi

  # The two CLIs' versions, as facts: a CLI that renames a verb shows here
  # before it is a runtime failure (#44). Builtins only after the call, so
  # the fixture PATH lists need no head.
  if have claude; then
    v="$(claude --version 2>/dev/null)"
    note "claude ${v%%$'\n'*}"
  fi
  if have codex; then
    v="$(codex --version 2>/dev/null)"
    note "codex ${v%%$'\n'*}"
  fi

  # Redundant Codex links: anything under CODEX_HOME/skills that resolves
  # into the shared root Codex already reads directly, deduping by resolved
  # path. Reported generically; their removal is sub-project 5's call.
  if [ -d "$CODEX_SKILLS" ]; then
    local redundant=0
    for link in "$CODEX_SKILLS"/*; do
      [ -L "$link" ] || continue
      actual="$(readlink -f "$link" 2>/dev/null)"
      case "$actual" in
        "$SKILL_ROOT"/*) redundant=$((redundant + 1)) ;;
      esac
    done
    [ "$redundant" -gt 0 ] && note "$redundant link(s) under $CODEX_SKILLS resolve into $SKILL_ROOT, which Codex already reads directly; they are redundant and are left alone"
  fi

  before=$REPORTED
  report_duplicates
  reported "$before" report_duplicates
}

# One skill name reaching two different trees on one agent CLI. Derived
# from every route that CLI loads a skill by, never from a declared list:
# its user skill root, the shared root, and the install path of each of its
# plugins. Three rules, each earned from a measured false positive on a clean
# machine (spec section 6.6): compare content, not path, so the thirteen
# subset-entry links into the pinned clone are not thirteen findings; take only
# the current version of each installed plugin, which the install registry
# names, so a plugin bump does not manufacture duplicates of its own skills;
# a cache whose marketplace is no longer registered is ensure_cache's, below.
# Per agent CLI, because the hazard is one name reaching two skills in one
# session; the two CLIs running different versions of a third-party plugin is
# a different, milder thing and is not reported here.
report_duplicates() {
  local -a claude_dirs=() codex_dirs=()
  local root dir path mkt name version line F before
  local can_hash=1
  # Guarded once here, not inside report_pool: report_pool runs once per
  # CLI, and a guard placed there would print this SKIP twice.
  needs sha256sum "the skill trees cannot be compared by content, so the duplicate check is unanswered" \
    || can_hash=0

  # A plugin's skills sit under skills/, or at its root when a git-subdir
  # entry's path already is the skills directory, as the superpowers entry's
  # is. Both are listed; a directory without SKILL.md is skipped below.
  plugin_skill_dirs() {
    local path="$1" dir
    for dir in "$path"/skills/*/ "$path"/*/; do
      [ -f "$dir/SKILL.md" ] && printf '%s\n' "${dir%/}"
    done
  }

  for root in "$HOME/.claude/skills" "$SKILL_ROOT"; do
    [ -d "$root" ] || continue
    for dir in "$root"/*/; do [ -f "$dir/SKILL.md" ] && claude_dirs+=("${dir%/}"); done
  done
  if [ -f "$INSTALLED_PLUGINS" ]; then
    while IFS= read -r path; do
      [ -n "$path" ] || continue
      while IFS= read -r dir; do claude_dirs+=("$dir"); done < <(plugin_skill_dirs "$path")
    done < <(jq -r '.plugins[]?[]?.installPath // empty' "$INSTALLED_PLUGINS" 2>/dev/null)
  fi
  if [ "$can_hash" -eq 1 ]; then
    before=$REPORTED
    report_pool Claude "${claude_dirs[@]}"
    reported "$before" report_pool
  fi

  for root in "$CODEX_SKILLS" "$SKILL_ROOT"; do
    [ -d "$root" ] || continue
    for dir in "$root"/*/; do [ -f "$dir/SKILL.md" ] && codex_dirs+=("${dir%/}"); done
  done
  # Codex loads an installed plugin from its cache, keyed by marketplace,
  # name and installed version; `codex plugin list --json` names all three.
  if [ -n "$CODEX_LIST" ]; then
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      split_tsv "$line"
      mkt="${F[0]}" name="${F[1]}" version="${F[2]}"
      if [ -z "$mkt" ] || [ -z "$name" ] || [ -z "$version" ]; then
        bad "a codex plugin list entry is malformed: marketplace='$mkt' name='$name' version='$version'"
        continue
      fi
      path="${CODEX_HOME:-$HOME/.codex}/plugins/cache/$mkt/$name/$version"
      while IFS= read -r dir; do codex_dirs+=("$dir"); done < <(plugin_skill_dirs "$path")
    done < <(printf '%s' "$CODEX_LIST" \
      | jq -r '.installed[]? | select(.enabled) | [.marketplaceName, .name, .version] | @tsv')
  fi
  # Conditional on the pool being complete, not on `have codex`: with codex present
  # and `codex plugin list --json` failed, CODEX_LIST is empty, the FAIL line
  # already stands above, and an all-clear here would speak for a pool
  # missing its plugin half (#40).
  if [ "$can_hash" -eq 1 ] && [ -n "$CODEX_LIST" ]; then
    before=$REPORTED
    report_pool Codex "${codex_dirs[@]}"
    reported "$before" report_pool
  fi
}

# $1 the agent CLI's name, then every skill directory that CLI can load.
# Hashing SKILL.md is the content identity: two paths with one hash are the
# same skill, and a name with two hashes is the finding.
report_pool() {
  local cli="$1" dir name h found=0 hashed=0
  local -A hashes=() places=()
  local -a distinct
  shift
  for dir in "$@"; do
    name="$(basename "$dir")"
    h="$(sha256sum "$dir/SKILL.md" 2>/dev/null)" || continue
    hashed=$((hashed + 1))
    h="${h%% *}"
    case " ${hashes[$name]:-} " in
      *" $h "*) ;;
      *)
        hashes[$name]="${hashes[$name]:-} $h"
        places[$name]="${places[$name]:-}${places[$name]:+, }$dir (${h:0:12})"
        ;;
    esac
  done
  for name in "${!hashes[@]}"; do
    read -r -a distinct <<<"${hashes[$name]}"
    [ "${#distinct[@]}" -gt 1 ] || continue
    found=$((found + 1))
    note "$cli: skill $name resolves to ${#distinct[@]} different trees: ${places[$name]}"
  done
  [ "$found" -eq 0 ] && note "$cli: $hashed skill tree(s) hashed; no name resolves to more than one tree"
}

# The one class of residue this script can prove (spec §11, #25): a Claude
# plugin cache directory whose marketplace known_marketplaces.json no longer
# names, or one of the CLI's temp_subdir_*.clone scratch clones from a
# git-subdir install, is deleted in apply mode when four facts hold, each
# read from a registry or from the directory itself: the registry parses as
# exactly one JSON object; the directory's name is absent from its keys; the
# install registry parses as exactly one JSON object whose .plugins is an
# object, no installPath in it lies under the directory, comparing both
# the literal and the canonical (readlink -f) form of each side so a
# trailing slash on $HOME or a symlinked ancestor cannot hide an installed
# plugin from the guard, and no key in it names the directory after its @
# (plug@held holds held), so an entry that records no installPath still
# holds its marketplace's cache; and the directory's own mtime is over an
# hour old. An installed entry that has neither a string installPath nor an
# @marketplace in its key could be holding any directory, so it skips the
# whole walk, naming the key, and nothing is deleted.
# A registry that is blank, malformed, or not a single JSON object of the
# right shape skips the whole walk and nothing is deleted -- jq's slurp mode
# reads a 0-byte or blank file as zero documents rather than a parse error,
# so the guard demands exactly one document, not merely a document that
# parses (plan B erratum: an empty or blank registry used to pass both parse
# guards and leave every directory unregistered and unprotected). Deleted,
# not moved aside: aside_path() is for what a user made and might want back;
# a cache the CLI regenerates from a marketplace that no longer exists is
# not, and a pile of aside copies would keep the disk cost and add something
# the walk must skip. The Codex half only reports (plan B, P1): Codex's own
# built-in marketplaces are in no file and no list, so residue there cannot
# be told from the CLI's own cache; a directory that neither config.toml's
# [marketplaces.*] tables nor an installed plugin accounts for is named and
# left alone.
ensure_cache() {
  local root dir name what why keys installed tag v paths="" held="" bare="" unplaced=0 p n=0 registered=0 registered_here k
  local canon_dir canon_p
  local croot cfg cnames="" cpaths="" line F
  root="${HOME%/}/.claude/plugins/cache"
  croot="${CODEX_HOME:-$HOME/.codex}/plugins/cache"
  cfg="${CODEX_HOME:-$HOME/.codex}/config.toml"
  needs jq "the plugin registries cannot be read, so no cache directory is judged" || return
  if [ ! -d "$root" ]; then
    ok "no Claude plugin cache at $root"
  elif ! keys="$(jq -rs 'if length == 1 and (.[0] | type) == "object" then .[0] | keys[] else error("not one object") end' "$KNOWN_MARKETPLACES" 2>/dev/null)"; then
    skip "$KNOWN_MARKETPLACES does not parse as a JSON object, so no cache directory is judged and none is deleted"
  elif ! installed="$(jq -rs 'if length == 1 and (.[0] | type) == "object" and (.[0].plugins | type) == "object"
      then .[0].plugins | to_entries[] | .key as $k | ($k | test("@[^@]+$")) as $named
        | (if $named then "held\t" + ($k | sub("^.*@"; "")) else empty end),
          (.value[]? | .installPath
            | if type == "string" then "path\t" + . elif $named then empty else "bare\t" + $k end)
      else error("not one object") end' "$INSTALLED_PLUGINS" 2>/dev/null)"; then
    skip "$INSTALLED_PLUGINS does not parse as a JSON object with a plugins object, so no cache directory is judged and none is deleted"
  else
    # One pass read three lists: each installPath; each marketplace an
    # installed plugin's key names after its @; and each key that names no
    # marketplace on an entry that records no installPath. Split at the first
    # tab by expansion, not by a tab IFS (see split_tsv), so an empty value
    # is kept.
    while IFS= read -r line; do
      tag="${line%%$'\t'*}" v="${line#*$'\t'}"
      case "$tag" in
        path) paths="$paths$v"$'\n' ;;
        held) held="$held$v"$'\n' ;;
        bare) unplaced=1 bare="$v" ;;
      esac
    done <<<"$installed"
    # An entry that neither lies under a directory nor names a marketplace
    # could be holding any of them, so none is judged.
    if [ "$unplaced" -eq 1 ]; then
      skip "installed_plugins.json entry $bare has no installPath and no @marketplace; not walking"
    else
      for dir in "$root"/*/; do
        [ -d "$dir" ] || continue
        dir="${dir%/}"
        name="${dir##*/}"
        n=$((n + 1))
        # A builtin membership test, not grep: no external's exit code stands
        # between a registered marketplace and its cache.
        registered_here=0
        while IFS= read -r k; do
          [ "$k" = "$name" ] && registered_here=1
        done <<<"$keys"
        if [ "$registered_here" -eq 1 ]; then
          registered=$((registered + 1))
          continue
        fi
        case "$name" in
          temp_subdir_*.clone) what="scratch clone from a git-subdir install" ;;
          *) what="cache for an unregistered marketplace" ;;
        esac
        canon_dir="$(readlink -f "$dir" 2>/dev/null)" || canon_dir="$dir"
        why=""
        while IFS= read -r p; do
          [ -n "$p" ] || continue
          canon_p="$(readlink -f "$p" 2>/dev/null)" || canon_p="$p"
          case "$p" in "$dir" | "$dir"/* | "$canon_dir" | "$canon_dir"/*) why="an installed plugin's installPath lies under it" ;; esac
          case "$canon_p" in "$dir" | "$dir"/* | "$canon_dir" | "$canon_dir"/*) why="an installed plugin's installPath lies under it" ;; esac
        done <<<"$paths"
        # An entry the registry records with no installPath still names its
        # marketplace in its key; a builtin membership test, as above.
        if [ -z "$why" ]; then
          while IFS= read -r k; do
            [ "$k" = "$name" ] && why="an installed plugin's key names this marketplace"
          done <<<"$held"
        fi
        if [ -z "$why" ] && [ -z "$(find "$dir" -maxdepth 0 -mmin +60)" ]; then
          why="modified less than an hour ago"
        fi
        if [ -n "$why" ]; then
          note "left alone: $dir ($why)"
        elif applying; then
          if rm -rf -- "$dir"; then
            did "deleted $what: $dir"
          else
            bad "could not delete $what: $dir"
          fi
        else
          bad "$what: $dir (not in known_marketplaces.json, no installed plugin under it, unmodified for over an hour); bin/setup deletes it"
        fi
      done
      ok "$n Claude plugin cache director(ies) walked, $registered registered"
    fi
  fi

  [ -d "$croot" ] || return
  if ! have codex; then
    return
  elif [ -z "$CODEX_LIST" ]; then
    skip "codex plugin list failed earlier, so the Codex plugin cache is not judged"
    return
  fi
  if [ -f "$cfg" ]; then
    while IFS= read -r line; do
      case "$line" in
        '[marketplaces.'*']')
          line="${line:14}" # past the 14 characters of [marketplaces.
          cnames="$cnames ${line%]}"
          ;;
      esac
    done <"$cfg"
  fi
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    split_tsv "$line"
    cpaths="$cpaths"$'\n'"$croot/${F[0]}/${F[1]}/${F[2]}"
  done < <(printf '%s' "$CODEX_LIST" | jq -r '.installed[]? | [.marketplaceName, .name, .version] | @tsv')
  for dir in "$croot"/*/; do
    [ -d "$dir" ] || continue
    dir="${dir%/}"
    name="${dir##*/}"
    case " $cnames " in *" $name "*) continue ;; esac
    why=""
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      case "$p" in "$dir" | "$dir"/*) why=under ;; esac
    done <<<"$cpaths"
    [ -n "$why" ] || note "Codex plugin cache for a marketplace config.toml does not record: $dir (left alone; remove it by hand)"
  done
}

main() {
  local before
  while [ $# -gt 0 ]; do
    case "$1" in
      --check) MODE=check ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        printf 'ERROR: unknown argument: %s\n\n' "$1" >&2
        usage >&2
        exit 2
        ;;
    esac
    shift
  done

  require_tools
  [ -f "$MARKETPLACE" ] || die "no desired state beside this script: $MARKETPLACE is missing"
  [ -f "$SKILLS_JSON" ] || die "no desired state beside this script: $SKILLS_JSON is missing"

  before=$REPORTED
  ensure_fresh_clone
  reported "$before" ensure_fresh_clone
  before=$REPORTED
  ensure_watch_fresh
  reported "$before" ensure_watch_fresh
  before=$REPORTED
  ensure_clones
  reported "$before" ensure_clones
  before=$REPORTED
  ensure_links
  reported "$before" ensure_links
  before=$REPORTED
  ensure_claude
  reported "$before" ensure_claude
  before=$REPORTED
  ensure_codex
  reported "$before" ensure_codex
  before=$REPORTED
  ensure_cache
  reported "$before" ensure_cache
  before=$REPORTED
  ensure_skills_sh
  reported "$before" ensure_skills_sh
  before=$REPORTED
  report_only
  reported "$before" report_only

  if applying; then
    printf '\n--- re-checking ---\n'
    "$BASH" "$REPO_ROOT/bin/setup" --check
    exit $?
  fi
  # An unread machine is not a healthy one: a dead detector must not look like a
  # converged repository. Exit 1 rather than 2 -- the doctor ran, it simply
  # could not answer -- with a verdict worded so it cannot be mistaken for
  # ordinary drift.
  if [ -n "$UNCHECKED" ]; then
    printf '\n%s check(s) could not run for want of:%s; this machine is unchecked, not verified\n' \
      "$UNANSWERED" "$UNCHECKED"
  fi
  if [ "$FAILURES" -gt 0 ]; then
    printf '\n%s check(s) failed\n' "$FAILURES"
  fi
  if [ "$FAILURES" -gt 0 ] || [ -n "$UNCHECKED" ]; then
    exit 1
  fi
  printf '\nclean\n'
  exit 0
}

main "$@"
